# ==============================================================================
# Alexa+ MCP Server - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials.
# Note: Never commit production credentials or sensitive keys to version control.

# ------------------------------------------------------------------------------
# 1. Flask Application Server Configuration
# ------------------------------------------------------------------------------
# Network host address to bind the HTTP server (0.0.0.0 binds to all network interfaces)
FLASK_HOST=0.0.0.0

# HTTP port on which the Flask/Waitress server listens
FLASK_PORT=5000

# Application deployment mode: 'production', 'development', or 'testing'
FLASK_ENV=production

# Enable or disable Flask debug mode (must remain 'false' in production)
FLASK_DEBUG=false

# Cryptographic secret key used for session signing and CSRF tokens
SECRET_KEY=alexa-plus-super-secret-mcp-key-change-me-in-production

# ------------------------------------------------------------------------------
# 2. Database Connection Configuration (SQLAlchemy)
# ------------------------------------------------------------------------------
# Default: Local SQLite database file in the project directory
DATABASE_URL=sqlite:///alexa_mcp.db

# Example: Production PostgreSQL database connection
# DATABASE_URL=postgresql://alexa_user:db_password_here@localhost:5432/alexa_db

# Example: AWS RDS PostgreSQL with SSL enabled
# DATABASE_URL=postgresql://alexa_admin:secret@rds-host.amazonaws.com:5432/alexa_db?sslmode=require

# Optional: AWS DynamoDB table name for persistent user memory in serverless deployments
USER_MEMORY_TABLE=alexa-plus-user-memory-prod

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Engine Configuration
# ------------------------------------------------------------------------------
# Google Gemini API key from Google AI Studio (https://aistudio.google.com/)
# Required for autonomous reasoning, intent routing, and tool execution
GEMINI_API_KEY=your_gemini_api_key_here

# Target Gemini model version (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. Amazon Alexa Skills Kit & ProactiveEvents Credentials
# ------------------------------------------------------------------------------
# Amazon Alexa Skill ID (amzn1.ask.skill.xxxx-xxxx) from Alexa Developer Console
ALEXA_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000

# Skill Messaging Client ID (Alexa Developer Console -> Permissions -> Skill Messaging)
ALEXA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Skill Messaging Client Secret used to request OAuth2 access tokens for ProactiveEvents
ALEXA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alexa Proactive Events API base endpoint:
# North America: https://api.amazonalexa.com
# Europe:        https://api.eu.amazonalexa.com
# Far East:      https://api.fe.amazonalexa.com
ALEXA_API_ENDPOINT=https://api.amazonalexa.com

# ------------------------------------------------------------------------------
# 5. Server-Sent Events (SSE) & Real-time Streaming Configuration
# ------------------------------------------------------------------------------
# Interval in seconds between keep-alive ping comments to maintain open HTTP streaming connections
KEEP_ALIVE_INTERVAL=15

# Interval in seconds between database queries to detect and push new live events to SSE clients
DB_POLL_INTERVAL=3

# ------------------------------------------------------------------------------
# 6. External Webhook Integrations
# ------------------------------------------------------------------------------
# Outbound webhook URL for broadcasting automation triggers, smart home dispatches, and third-party webhooks
EXTERNAL_WEBHOOK_URL=https://httpbin.org/post

# ------------------------------------------------------------------------------
# 7. Logging & Telemetry Configuration
# ------------------------------------------------------------------------------
# Logging verbosity level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO
