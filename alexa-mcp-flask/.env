# Alexa+ MCP Server Configuration
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=alexa_mcp_super_secret_hackathon_key_2026

# Database Connection (Default: SQLite, for PostgreSQL use postgresql://user:pass@localhost:5432/alexa_db)
DATABASE_URL=sqlite:///alexa_mcp.db

# SSE & Keep-alive configuration (in seconds)
KEEP_ALIVE_INTERVAL=15
DB_POLL_INTERVAL=3

# External Tool Webhooks (Optional external integrations)
EXTERNAL_WEBHOOK_URL=https://httpbin.org/post
LOG_LEVEL=INFO

